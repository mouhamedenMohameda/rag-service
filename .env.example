# Clé OpenAI utilisée uniquement pour les embeddings (text-embedding-3-small).
# Récupère-la sur https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Clé secrète S2S entre Débloque-moi et rag-service. Génère 32 octets random :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_S2S_KEY=changeme-generate-random

# Dossier où Chroma persiste le vector store
RAG_CHROMA_DIR=./data/chroma

# Dossier racine des PDFs à indexer (sera scanné récursivement)
RAG_PDF_ROOT=../drive_archive
